    <script>
        // Key Mapping (1 to 17) based on standard articulatory phonetics diagram
        const ORGANS_DATA = [
            { id: 1, name: "Nasal cavity", hint: "Large cavity above the oral cavity for nasal sounds." },
            { id: 2, name: "Upper and lower lips", hint: "Labial articulators (bilabial/labiodental)." },
            { id: 3, name: "Upper and lower teeth", hint: "Dental articulators used with lips/tongue." },
            { id: 4, name: "Alveolar ridge", hint: "Bony ridge right behind the upper teeth." },
            { id: 5, name: "Hard palate", hint: "Bony roof of the mouth behind alveolar ridge." },
            { id: 6, name: "Soft palate (velum)", hint: "Muscular roof section that lowers for nasal sound airflow." },
            { id: 7, name: "Uvula", hint: "Fleshy appendage hanging at the back of the velum." },
            { id: 8, name: "Tongue tip (apex)", hint: "The apex or tip of the tongue." },
            { id: 9, name: "Tongue bridge", hint: "The blade / upper front region of tongue." },
            { id: 10, name: "Tongue body", hint: "Main dorsum / mass of the tongue." },
            { id: 11, name: "Oral cavity", hint: "Main mouth cavity space." },
            { id: 12, name: "Pharynx", hint: "Throat passage behind oral and nasal cavities." },
            { id: 13, name: "Epiglottis", hint: "Leaf-shaped cartilage flap protecting trachea." },
            { id: 14, name: "Larynx", hint: "Voice box holding the vocal cords." },
            { id: 15, name: "Vocal cords", hint: "Vibrating membrane folds generating phonation." },
            { id: 16, name: "Trachea (tube to lungs)", hint: "Windpipe conducting air from lungs." },
            { id: 17, name: "Esophagus (tube to stomach)", hint: "Food tube behind the trachea." }
        ];

        // Game State Variables
        let matchedState = {}; // { 1: { id: 1, name: "Nasal cavity" }, ... }
        let score = 0;
        let totalAttempts = 0;
        let correctAttempts = 0;
        let selectedTermId = null; // For touch / click fallback
        let timerInterval = null;
        let secondsElapsed = 0;
        let soundEnabled = true;

        // Web Audio API Audio Synthesizer
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        let audioCtx = null;

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new AudioContext();
            }
        }

        function playSound(type) {
            if (!soundEnabled) return;
            initAudio();
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }

            const now = audioCtx.currentTime;

            if (type === 'success') {
                // Happy high chime chord
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(523.25, now); // C5
                osc.frequency.exponentialRampToValueAtTime(659.25, now + 0.1); // E5
                osc.frequency.exponentialRampToValueAtTime(783.99, now + 0.2); // G5
                gain.gain.setValueAtTime(0.15, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start(now);
                osc.stop(now + 0.35);
            } else if (type === 'error') {
                // Low buzz error sound
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(180, now);
                osc.frequency.linearRampToValueAtTime(110, now + 0.2);
                gain.gain.setValueAtTime(0.2, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start(now);
                osc.stop(now + 0.25);
            } else if (type === 'victory') {
                // Victory Arpeggio
                const notes = [523.25, 659.25, 783.99, 1046.50];
                notes.forEach((freq, idx) => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(freq, now + idx * 0.1);
                    gain.gain.setValueAtTime(0.2, now + idx * 0.1);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.1 + 0.4);
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start(now + idx * 0.1);
                    osc.stop(now + idx * 0.1 + 0.4);
                });
            }
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            const icon = document.getElementById('sound-icon');
            const btn = document.getElementById('sound-btn');
            if (soundEnabled) {
                icon.className = 'fa-solid fa-volume-high text-teal-400';
                btn.classList.remove('opacity-60');
            } else {
                icon.className = 'fa-solid fa-volume-xmark text-slate-400';
                btn.classList.add('opacity-60');
            }
        }

        // Utility: Fisher-Yates Shuffle
        function shuffleArray(arr) {
            const array = [...arr];
            for (let i = array.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [array[i], array[j]] = [array[j], array[i]];
            }
            return array;
        }

        // Initialize Game DOM Elements
        function initGame() {
            matchedState = {};
            score = 0;
            totalAttempts = 0;
            correctAttempts = 0;
            selectedTermId = null;
            secondsElapsed = 0;

            updateScoreboard();
            startTimer();

            // Render Target Drop Slots (1 to 17 in numerical order)
            const dropContainer = document.getElementById('drop-slots-container');
            dropContainer.innerHTML = '';

            ORGANS_DATA.forEach(organ => {
                const slot = document.createElement('div');
                slot.id = `slot-${organ.id}`;
                slot.dataset.id = organ.id;
                slot.className = `drop-slot bg-slate-50 border-2 border-dashed border-slate-300 rounded-xl p-2.5 flex items-center justify-between transition-all duration-200 min-h-[52px] cursor-pointer hover:border-slate-400`;
                
                slot.innerHTML = `
                    <div class="flex items-center gap-2.5 w-full">
                        <span class="w-7 h-7 rounded-lg bg-slate-800 text-white font-bold text-xs flex items-center justify-center shrink-0 shadow-sm">
                            ${organ.id}
                        </span>
                        <div class="slot-content flex-grow text-xs text-slate-400 font-medium italic">
                            Drop organ term #${organ.id} here...
                        </div>
                    </div>
                `;

                // Drag and Drop Event Listeners
                slot.addEventListener('dragover', handleDragOver);
                slot.addEventListener('dragenter', handleDragEnter);
                slot.addEventListener('dragleave', handleDragLeave);
                slot.addEventListener('drop', handleDrop);
                slot.addEventListener('click', () => handleSlotClick(organ.id));

                dropContainer.appendChild(slot);
            });

            // Populate Toolbox with randomized terms
            populateToolbox();
        }

        function populateToolbox() {
            const toolbox = document.getElementById('toolbox-container');
            toolbox.innerHTML = '';

            // Get remaining unplaced organs
            const unplaced = ORGANS_DATA.filter(item => !matchedState[item.id]);
            const randomized = shuffleArray(unplaced);

            if (randomized.length === 0) {
                toolbox.innerHTML = `<div class="text-xs text-emerald-400 font-semibold p-2 flex items-center gap-2"><i class="fa-solid fa-circle-check"></i> All terms successfully placed!</div>`;
                return;
            }

            randomized.forEach(organ => {
                const termBlock = document.createElement('div');
                termBlock.id = `term-${organ.id}`;
                termBlock.dataset.id = organ.id;
                termBlock.draggable = true;
                termBlock.className = `term-block bg-slate-700 hover:bg-slate-600 active:bg-slate-500 text-white border border-slate-600/80 font-medium text-xs rounded-lg px-3 py-2 cursor-grab active:cursor-grabbing transition duration-150 shadow-sm flex items-center gap-2 select-none`;

                termBlock.innerHTML = `
                    <i class="fa-solid fa-grip-vertical text-slate-400 text-xs"></i>
                    <span>${organ.name}</span>
                `;

                // Drag Event Listeners
                termBlock.addEventListener('dragstart', handleDragStart);
                termBlock.addEventListener('dragend', handleDragEnd);

                // Touch / Click Select Fallback
                termBlock.addEventListener('click', (e) => {
                    e.stopPropagation();
                    handleTermClick(organ.id);
                });

                toolbox.appendChild(termBlock);
            });
        }

        // Drag API Handlers
        let draggedTermId = null;

        function handleDragStart(e) {
            initAudio();
            draggedTermId = parseInt(this.dataset.id);
            e.dataTransfer.setData('text/plain', draggedTermId);
            e.dataTransfer.effectAllowed = 'move';
            this.classList.add('opacity-40');
        }

        function handleDragEnd(e) {
            this.classList.remove('opacity-40');
            draggedTermId = null;
        }

        function handleDragOver(e) {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
        }

        function handleDragEnter(e) {
            e.preventDefault();
            this.classList.add('drag-over');
        }

        function handleDragLeave(e) {
            this.classList.remove('drag-over');
        }

        function handleDrop(e) {
            e.preventDefault();
            this.classList.remove('drag-over');

            const targetSlotId = parseInt(this.dataset.id);
            const termId = parseInt(e.dataTransfer.getData('text/plain') || draggedTermId);

            if (termId) {
                attemptMatch(termId, targetSlotId);
            }
        }

        // Click / Touch Fallback Handlers
        function handleTermClick(termId) {
            initAudio();
            // Clear previous selection if any
            if (selectedTermId) {
                const prev = document.getElementById(`term-${selectedTermId}`);
                if (prev) prev.classList.remove('touch-selected', 'ring-2', 'ring-teal-400');
            }

            if (selectedTermId === termId) {
                selectedTermId = null; // Toggle deselect
                return;
            }

            selectedTermId = termId;
            const current = document.getElementById(`term-${termId}`);
            if (current) {
                current.classList.add('touch-selected', 'ring-2', 'ring-teal-400');
            }
        }

        function handleSlotClick(slotId) {
            if (selectedTermId && !matchedState[slotId]) {
                attemptMatch(selectedTermId, slotId);
                selectedTermId = null;
            }
        }

        // Core Game Match Logic
        function attemptMatch(termId, slotId) {
            totalAttempts++;
            const organ = ORGANS_DATA.find(o => o.id === termId);
            const slotElement = document.getElementById(`slot-${slotId}`);

            if (termId === slotId) {
                // CORRECT DROP
                correctAttempts++;
                score += 100;
                matchedState[slotId] = organ;

                playSound('success');

                // Update Slot UI
                slotElement.className = `drop-slot bg-emerald-50 border-2 border-emerald-500 rounded-xl p-2.5 flex items-center justify-between transition duration-300 animate-success shadow-sm`;
                slotElement.innerHTML = `
                    <div class="flex items-center gap-2.5 w-full">
                        <span class="w-7 h-7 rounded-lg bg-emerald-600 text-white font-bold text-xs flex items-center justify-center shrink-0 shadow-sm">
                            <i class="fa-solid fa-check"></i>
                        </span>
                        <div class="flex-grow">
                            <span class="text-xs font-bold text-emerald-900">${organ.name}</span>
                            <span class="text-[10px] text-emerald-600 block">Number ${organ.id}</span>
                        </div>
                    </div>
                `;

                // Remove term block from toolbox
                const termBlock = document.getElementById(`term-${termId}`);
                if (termBlock) termBlock.remove();

                // Update Progress and Check Victory
                updateScoreboard();

                if (Object.keys(matchedState).length === ORGANS_DATA.length) {
                    triggerVictory();
                }

            } else {
                // INCORRECT DROP
                score = Math.max(0, score - 25);
                playSound('error');

                // Shake animation on target slot & term block
                slotElement.classList.add('animate-shake', 'border-red-400', 'bg-red-50');
                
                const termBlock = document.getElementById(`term-${termId}`);
                if (termBlock) {
                    termBlock.classList.add('animate-shake', 'bg-red-600');
                }

                setTimeout(() => {
                    slotElement.classList.remove('animate-shake', 'border-red-400', 'bg-red-50');
                    if (termBlock) {
                        termBlock.classList.remove('animate-shake', 'bg-red-600');
                    }
                    // Return block automatically to toolbox (re-populate container if needed)
                    populateToolbox();
                }, 450);

                updateScoreboard();
            }
        }

        function updateScoreboard() {
            const count = Object.keys(matchedState).length;
            document.getElementById('progress-text').innerText = `${count} / ${ORGANS_DATA.length}`;
            document.getElementById('placed-counter').innerText = `${count} / ${ORGANS_DATA.length} Matched`;

            const percentage = Math.round((count / ORGANS_DATA.length) * 100);
            document.getElementById('progress-bar').style.width = `${percentage}%`;

            document.getElementById('score-display').innerText = score;

            const accuracy = totalAttempts > 0 ? Math.round((correctAttempts / totalAttempts) * 100) : 100;
            document.getElementById('accuracy-display').innerText = `${accuracy}%`;
        }

        function startTimer() {
            clearInterval(timerInterval);
            secondsElapsed = 0;
            timerInterval = setInterval(() => {
                secondsElapsed++;
                const mins = Math.floor(secondsElapsed / 60).toString().padStart(2, '0');
                const secs = (secondsElapsed % 60).toString().padStart(2, '0');
                document.getElementById('timer-display').innerText = `${mins}:${secs}`;
            }, 1000);
        }

        function triggerHint() {
            initAudio();
            // Find unplaced organs
            const unplaced = ORGANS_DATA.filter(o => !matchedState[o.id]);
            if (unplaced.length === 0) return;

            const target = unplaced[Math.floor(Math.random() * unplaced.length)];
            
            // Deduct score penalty
            score = Math.max(0, score - 20);
            updateScoreboard();

            // Pulse highlight matching slot and term block
            const slot = document.getElementById(`slot-${target.id}`);
            const term = document.getElementById(`term-${target.id}`);

            if (slot) slot.classList.add('animate-hint');
            if (term) term.classList.add('animate-hint');

            setTimeout(() => {
                if (slot) slot.classList.remove('animate-hint');
                if (term) term.classList.remove('animate-hint');
            }, 2500);
        }

        function triggerVictory() {
            clearInterval(timerInterval);
            playSound('victory');

            const mins = Math.floor(secondsElapsed / 60).toString().padStart(2, '0');
            const secs = (secondsElapsed % 60).toString().padStart(2, '0');
            const accuracy = Math.round((correctAttempts / totalAttempts) * 100);

            document.getElementById('modal-score').innerText = score;
            document.getElementById('modal-time').innerText = `${mins}:${secs}`;
            document.getElementById('modal-accuracy').innerText = `${accuracy}%`;

            const modal = document.getElementById('victory-modal');
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modal.children[0].classList.remove('scale-95');
                modal.children[0].classList.add('scale-100');
            }, 10);

            launchConfetti();
        }

        function resetGame() {
            const modal = document.getElementById('victory-modal');
            modal.classList.add('opacity-0');
            modal.children[0].classList.remove('scale-100');
            modal.children[0].classList.add('scale-95');
            
            setTimeout(() => {
                modal.classList.add('hidden');
                initGame();
            }, 300);
        }

        // Lightweight Canvas Confetti Generator
        function launchConfetti() {
            const canvas = document.getElementById('confetti-canvas');
            const ctx = canvas.getContext('2d');
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = canvas.parentElement.clientHeight;

            const particles = [];
            const colors = ['#0d9488', '#0284c7', '#f59e0b', '#10b981', '#6366f1'];

            for (let i = 0; i < 70; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height - canvas.height,
                    size: Math.random() * 6 + 4,
                    color: colors[Math.floor(Math.random() * colors.length)],
                    vy: Math.random() * 3 + 2,
                    vx: Math.random() * 2 - 1
                });
            }

            function animateConfetti() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                let alive = false;

                particles.forEach(p => {
                    p.y += p.vy;
                    p.x += p.vx;
                    ctx.fillStyle = p.color;
                    ctx.fillRect(p.x, p.y, p.size, p.size);

                    if (p.y < canvas.height) alive = true;
                });

                if (alive) requestAnimationFrame(animateConfetti);
            }

            animateConfetti();
        }

        // Window Load Initialization
        window.onload = function() {
            initGame();
        };
    </script>
</body>
</html>
